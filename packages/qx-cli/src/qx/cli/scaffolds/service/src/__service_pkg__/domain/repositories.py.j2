"""Repository interfaces — domain contracts.

Define WHAT the infrastructure layer must implement.
Handlers depend only on these protocols; SQLAlchemy stays in infrastructure.

Swap the database engine without touching a single command or query handler.

Example:

    class IOrderRepository(Protocol):
        async def get(self, id: UUID) -> Result: ...
        async def save(self, entity: Order) -> Result[None]: ...

    # In infrastructure/persistence/order/repository.py:
    class OrderRepository(Repository[Order]):
        ...  # implements IOrderRepository implicitly (structural subtyping)
"""

from __future__ import annotations

from typing import Protocol
from uuid import UUID

from qx.core import Result
